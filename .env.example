# ---- Core ----
DATABASE_URL=postgresql://coldstack:coldstack@localhost:5432/coldstack
REDIS_URL=redis://localhost:6379/0
APP_SECRET=change-me-32-bytes-base64
# Master key for envelope-encrypting per-workspace BYOK credentials
CREDENTIAL_MASTER_KEY=change-me-base64-32-bytes

# ---- BYOK: everything below is OPTIONAL and stored per-workspace in the UI.
# These are only for local dev / single-tenant self-hosting. ----

# People + company search
APOLLO_API_KEY=
PDL_API_KEY=
CRUSTDATA_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=

# Email finding
HUNTER_API_KEY=
FINDYMAIL_API_KEY=
LEADMAGIC_API_KEY=
DROPCONTACT_API_KEY=

# Verification
REACHER_URL=http://localhost:8080
ZEROBOUNCE_API_KEY=
MILLIONVERIFIER_API_KEY=

# LLM (BYOK - pick one or more)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
